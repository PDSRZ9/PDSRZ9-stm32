--cpu Cortex-M3
"hal_delay\startup_stm32f103xb.o"
"hal_delay\main.o"
"hal_delay\stm32f1xx_it.o"
"hal_delay\stm32f1xx_hal_msp.o"
"hal_delay\stm32f1xx_hal_gpio_ex.o"
"hal_delay\stm32f1xx_hal.o"
"hal_delay\stm32f1xx_hal_rcc.o"
"hal_delay\stm32f1xx_hal_rcc_ex.o"
"hal_delay\stm32f1xx_hal_gpio.o"
"hal_delay\stm32f1xx_hal_dma.o"
"hal_delay\stm32f1xx_hal_cortex.o"
"hal_delay\stm32f1xx_hal_pwr.o"
"hal_delay\stm32f1xx_hal_flash.o"
"hal_delay\stm32f1xx_hal_flash_ex.o"
"hal_delay\stm32f1xx_hal_exti.o"
"hal_delay\system_stm32f1xx.o"
--strict --scatter "HAL_DELAY\HAL_DELAY.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "HAL_DELAY.map" -o HAL_DELAY\HAL_DELAY.axf