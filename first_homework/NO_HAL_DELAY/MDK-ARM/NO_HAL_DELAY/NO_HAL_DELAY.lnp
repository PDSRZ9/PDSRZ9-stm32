--cpu Cortex-M3
"no_hal_delay\startup_stm32f103xb.o"
"no_hal_delay\main.o"
"no_hal_delay\stm32f1xx_it.o"
"no_hal_delay\stm32f1xx_hal_msp.o"
"no_hal_delay\stm32f1xx_hal_gpio_ex.o"
"no_hal_delay\stm32f1xx_hal_tim.o"
"no_hal_delay\stm32f1xx_hal_tim_ex.o"
"no_hal_delay\stm32f1xx_hal.o"
"no_hal_delay\stm32f1xx_hal_rcc.o"
"no_hal_delay\stm32f1xx_hal_rcc_ex.o"
"no_hal_delay\stm32f1xx_hal_gpio.o"
"no_hal_delay\stm32f1xx_hal_dma.o"
"no_hal_delay\stm32f1xx_hal_cortex.o"
